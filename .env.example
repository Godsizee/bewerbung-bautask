N8N_AGENT_WEBHOOK_URL=https://n8n.godsize.info/webhook/frag-basti
AGENT_SHARED_SECRET=your_shared_secret_here
ORIGIN=http://localhost:5173

# Nur fuer den Prebuild-Schritt (scripts/n8n-zahlen.ts), holt Live-Workflow-Zahlen.
# Lokal alternativ ueber die DPAPI-verschluesselte Datei aus getApiKey() moeglich.
# Produktiv zwingend gueltig: ohne Key bleibt die Workflow-Zahl auf dem eingecheckten
# Stand stehen, waehrend daneben "beim Build automatisch nachgezaehlt" steht.
# Im Build-Log pruefen: "[n8n-zahlen] Aktualisiert: ..." = gut, "Nutze gecachte" = Key tot.
N8N_API_KEY=

# Produktiv (Coolify) zwingend setzen, sonst greift das Rate-Limit in +server.ts
# global statt pro Besucher-IP, weil getClientAddress() sonst die Traefik-Container-IP liefert.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1
